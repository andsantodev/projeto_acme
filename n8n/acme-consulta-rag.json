      },
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 1,
      "position": [
        220,
        0
      ],
      "name": "Hash do segredo"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "secret-hash",
              "leftValue": "={{ $json.secretHash }}",
              "rightValue": "9e4d3c470fa8a47cf9d5fbc74a62e295e00592d7639c22d5c808c59875dacd32",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        0
      ],
      "name": "Segredo valido?"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "question",
              "name": "question",
              "value": "={{ $('Webhook da consulta').first().json.body.question }}",
              "type": "string"
            },
            {
              "id": "history",
              "name": "history",
              "value": "={{ $('Webhook da consulta').first().json.body.history }}",
              "type": "array"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        660,
        -140
      ],
      "name": "Normalizar entrada"
    },
    {
      "parameters": {
        "mode": "load",
        "tableName": {
          "__rl": true,
          "mode": "list",
          "value": "acme_documents_vec"
        },
        "prompt": "={{ $json.question }}",
        "topK": 4,
        "options": {
          "queryName": "acme_match_documents"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.vectorStoreSupabase",
      "typeVersion": 1,
      "position": [
        880,
        -140
      ],
      "name": "Buscar trechos"
    },
    {
      "parameters": {
        "model": "openai/text-embedding-3-small",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1,
      "position": [
        976,
        336
      ],
      "name": "Embeddings OpenRouter"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "relevant-score",
              "leftValue": "={{ $json.score }}",
              "rightValue": 0.4,
              "operator": {
                "type": "number",
                "operation": "gte"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1100,
        -140
      ],
      "name": "Encontrou trechos?"
    },
    {
      "parameters": {
        "aggregate": "aggregateAllItemData",
        "destinationFieldName": "context",
        "options": {}
      },
      "type": "n8n-nodes-base.aggregate",
      "typeVersion": 1,
      "position": [
        1320,
        -240
      ],
      "name": "Agrupar trechos"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"model\": \"deepseek/deepseek-v4.1-flash\", \"temperature\": 0.2, \"reasoning\": { \"effort\": \"low\" }, \"messages\": [ { \"role\": \"system\", \"content\": \"Voce e o assistente de onboarding da Acme. Responda em portugues do Brasil, em no maximo 3 paragrafos, usando apenas os trechos fornecidos. Cite o nome do documento quando fizer sentido. Se os trechos nao responderem a pergunta, diga que nao encontrou nos documentos da empresa e sugira abrir um chamado.\" }, { \"role\": \"user\", \"content\": \"Pergunta: \" + $('Normalizar entrada').first().json.question + \"\\n\\nTrechos:\\n\" + JSON.stringify($('Agrupar trechos').first().json.context) } ] } }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        -240
      ],
      "name": "Consultar modelo"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "answer",
              "name": "answer",
              "value": "={{ $json.choices[0].message.content }}",
              "type": "string"
            },
            {
              "id": "sources",
              "name": "sources",
              "value": "={{ Object.values($('Agrupar trechos').first().json.context.reduce((acc, item) => { const doc = item.document.metadata.source; if (!acc[doc] || item.score > acc[doc].score) { acc[doc] = { document: doc, excerpt: item.document.pageContent.slice(0, 240), score: item.score }; } return acc; }, {})).map((entry) => ({ document: entry.document, excerpt: entry.excerpt })) }}",
              "type": "array"
            },
            {
              "id": "grounded",
              "name": "grounded",
              "value": true,
              "type": "boolean"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1760,
        -240
      ],
      "name": "Montar resposta"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"answer\": $json.answer, \"sources\": $json.sources, \"grounded\": $json.grounded } }}",
        "options": {}
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        1980,
        -240
      ],
      "name": "Responder resultado"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"answer\": \"Nao encontrei essa informacao nos documentos da empresa. Vale abrir um chamado para o time responsavel.\", \"sources\": [], \"grounded\": false } }}",
        "options": {}
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        1320,
        60
      ],
      "name": "Responder sem base"
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"error\": \"unauthorized\" } }}",
        "options": {
          "responseCode": 401
        }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        660,
        200
      ],
      "name": "Responder 401"
    },
    {
      "parameters": {
        "content": "## Entrada e segredo\nO webhook so aceita POST com o header `x-acme-secret`.\nO node Crypto calcula o SHA-256 do header e o IF compara com o hash fixo: o segredo em texto nao fica no workflow.",
        "height": 150,
        "width": 300
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -260,
        -260
      ],
      "name": "Nota 1"
    },
    {
      "parameters": {
        "content": "## Busca vetorial\nEmbeddings da pergunta com `openai/text-embedding-3-small` e busca topK 4 via `acme_match_documents` (RPC propria, isolada no banco compartilhado).",
        "height": 170,
        "width": 320
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        820,
        -380
      ],
      "name": "Nota 2"
    },
    {
      "parameters": {
        "content": "## Quando nao ha base\nSe nenhum trecho passa do limiar de similaridade (0.4), responde `grounded:false` com `sources:[]` **sem chamar o modelo** — nada de resposta inventada.",
        "height": 160,
        "width": 320
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        1040,
        -380
      ],
      "name": "Nota 3"
    },
    {
      "parameters": {
        "content": "## Resposta\nHTTP Request para o OpenRouter (`deepseek/deepseek-v4.1-flash`, temperature 0.2, reasoning.effort low) usando os trechos como contexto.\nA resposta segue o contrato do PRD 7.1: `answer`, `sources[{document, excerpt}]`, `grounded`.",
        "height": 170,
        "width": 340
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        1500,
        -380
      ],
      "name": "Nota 4"
    }
  ],

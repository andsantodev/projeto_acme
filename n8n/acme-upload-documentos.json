      "id": "31ccd036-6e24-44bc-8bb7-c2992eb2b164",
      "name": "Limpar fontes enviadas",
      "credentials": {
        "supabaseApi": {
          "id": "<credential-id>",
          "name": "Supabase do portal"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $('Formulário de upload').all();\nconst out = [];\nconst seen = {};\nfor (const item of items) {\n  const binary = item.binary || {};\n  for (const key of Object.keys(binary)) {\n    const bin = binary[key];\n    const name = bin.fileName || key;\n    if (!seen[name]) { seen[name] = true; out.push({ json: { fileName: name }, binary: { data: bin } }); }\n  }\n}\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        -140
      ],
      "id": "7e414149-61ff-4bdd-9052-66cd95714c86",
      "name": "Separar arquivos"
    },

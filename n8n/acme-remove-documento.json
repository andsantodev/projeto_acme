{
  "name": "Acme - Remover documento",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Acme - Remover documento",
        "formDescription": "Informe a senha e o nome do arquivo. Deixe o arquivo vazio para limpar a base inteira.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Senha do upload",
              "fieldName": "password",
              "fieldType": "password",
              "required": true
            },
            {
              "fieldLabel": "Arquivo a remover",
              "fieldName": "arquivo",
              "fieldType": "text",
              "required": false,
              "placeholder": "ex.: ferias.md (vazio = limpar tudo)"
            }
          ]
        },
        "options": {
          "path": "acme-remove-docs"
        }
      },
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        0,
        0

            "index": 0
          }
        ]
      ]
    },
    "Calcular hash da senha": {
      "main": [
        [
          {
            "node": "Senha correta?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Senha correta?": {
      "main": [
        [
          {
            "node": "Remover um arquivo?",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Senha inválida - encerrar",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Remover um arquivo?": {
      "main": [
        [
          {
            "node": "Remover arquivo",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Limpar base inteira",

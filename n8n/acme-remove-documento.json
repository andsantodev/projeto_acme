    {
      "parameters": {
        "operation": "delete",
        "tableId": "acme_documents_vec",
        "filterType": "string",
        "filterString": "=metadata->>source=eq.{{ $('Preparar dados').first().json.arquivo }}"
      },
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        1100,
        -140
      ],
      "id": "fa0053bb-083f-453e-9f37-c4f3d937e464",
      "name": "Remover arquivo",

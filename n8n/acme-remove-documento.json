              "id": "senha",
              "name": "senha",
              "value": "={{ $json[\"Senha do upload\"] || $json.password }}",
              "type": "string"
            },
            {
              "id": "arquivo",
              "name": "arquivo",
              "value": "={{ ($json['Arquivo a remover'] || '').trim() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",

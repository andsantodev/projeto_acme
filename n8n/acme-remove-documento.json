      },
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 1,
      "position": [
        440,
        0
      ],
      "id": "18c8f5e9-f150-410d-9c15-2af44801ade7",
      "name": "Calcular hash da senha"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "password-hash",
              "leftValue": "={{ $json.passwordHash }}",
              "rightValue": "f0ac2375c823ca62208820d93163bb1b173bef60b5fc3c71db7b9f442b46e60f",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        660,
        0
      ],
      "id": "cc5c88ee-c68e-4690-a0e2-7a8cab16bbd0",
      "name": "Senha correta?"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "has-file",
              "leftValue": "={{ $('Preparar dados').first().json.arquivo }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
        0
      ],
      "id": "6f71518e-c63f-4357-ae5f-261226f9c9ce",
      "name": "Remover um arquivo?"

    {
      "parameters": {
        "jsCode": "const first = $input.first();\nconst binary = first.binary || {};\nconst files = [];\nfor (const key of Object.keys(binary)) {\n  const file = binary[key];\n  if (file && file.fileName) files.push(file);\n}\nconst names = files.map((file) => file.fileName);\nconst namesValid =\n  names.length > 0 && names.every((name) => /^[a-zA-Z0-9._-]+\\.md$/i.test(name));\nreturn files.map((file) => ({\n  json: { fileName: file.fileName, names, namesValid },\n  binary: { data: file },\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        -144
      ],
      "name": "Coletar arquivos"
    },
    {
      "parameters": {
        "operation": "delete",
        "tableId": "acme_documents_vec",
        "filterType": "string",
        "filterString": "=metadata->>source=in.({{ $json.names.join(',') }})"
      },
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        896,
        -144
      ],
      "name": "Limpar fontes enviadas",
      "alwaysOutputData": true,
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "const files = $('Coletar arquivos').all();\nreturn files.map((item) => ({ json: { fileName: item.json.fileName }, binary: { data: item.binary.data } }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
